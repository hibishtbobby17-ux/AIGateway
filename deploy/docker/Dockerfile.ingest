FROM golang:1.26-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
COPY ingest/ ./ingest/
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/ingest ./ingest

FROM alpine:3.19
RUN apk add --no-cache ca-certificates curl wget
WORKDIR /app

COPY --from=builder /bin/ingest /app/ingest

EXPOSE 8082

HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8082/healthz || exit 1

ENTRYPOINT ["/app/ingest"]
