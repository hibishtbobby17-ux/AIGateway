# Environment variables template for Docker Compose deployment
# Copy to .env and adjust values before running: docker compose up -d

POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway_dev

GATEWAY_ENVIRONMENT=development
GATEWAY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GATEWAY_SIGNING_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GATEWAY_JWT_ISSUER=https://gateway.local
GATEWAY_JWT_AUDIENCE=gateway-api
