# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for Control Plane & Embedded Console

# Stage 1: Build React/TypeScript frontend
FROM node:20-alpine AS web-builder

WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci || npm install

COPY web/ ./
RUN npm run build

# Stage 2: Build Go binary embedding web/dist
FROM golang:1.26-alpine AS go-builder

WORKDIR /src
RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Overwrite/ensure web/dist contains the built frontend
COPY --from=web-builder /src/web/dist ./web/dist

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=1.0.0
ARG COMMIT=dev

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/control-plane \
    ./cmd/control-plane

# Stage 3: Hardened runtime
FROM alpine:3.19 AS runtime

RUN apk add --no-cache ca-certificates tzdata curl && \
    addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S appuser -G appgroup

WORKDIR /app

COPY --from=go-builder /out/control-plane /app/control-plane

USER 10001:10001

EXPOSE 8081

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://127.0.0.1:8081/healthz || exit 1

ENTRYPOINT ["/app/control-plane"]
